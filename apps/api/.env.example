# ─── AI provider ─────────────────────────────────────────────────────────────
# Set AI_ENABLED=true to enable real OpenRouter AI calls.
# Leave false in dev until you want to spend real API credits.
AI_ENABLED=false
# Second production-only gate. Keep false until durable storage, Clerk parties,
# provider credentials and all manual spending/privacy checks have been verified.
PRODUCTION_AI_ENABLED=false
AI_PROVIDER=openrouter
# Private key — backend only. Never put this in mobile code or commit to git.
OPENROUTER_API_KEY=
# Exact model IDs must be present in the server allowlist. Unknown values safely
# fall back to openai/gpt-4o-mini; see docs/security/PRODUCTION_AI_AUTH_CONFIGURATION.md.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=1024

# ─── Fable 5 (opt-in, via OpenRouter — not a separate SDK) ───────────────────
# Set FABLE_ENABLED=true to allow the private `x-okyo-model: fable` request
# header to route a scan through Fable 5 instead of the default OpenRouter
# model. Off by default — normal OpenRouter/gpt-4o-mini path is unaffected.
FABLE_ENABLED=false
FABLE_MODEL=anthropic/claude-fable-5
# Hard-clamped to 10 in code even if this is set higher.
FABLE_DAILY_REQUEST_CAP=10

# ─── Epicure ingredient intelligence (additive enrichment layer) ─────────────
# Set EPICURE_ENABLED=true to enrich recipe prompts with ingredient pairings and
# healthy/budget substitutions BEFORE recipe generation. When false (or no key),
# recipe generation behaves exactly as before. Reuses OPENROUTER_API_KEY above.
EPICURE_ENABLED=false
# Food-intelligence model used only by Epicure (separate from the vision/text
# models). Defaults to openai/gpt-4o-mini if unset.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Recipe cache TTL in days (default 7). Set to 0 to disable.
RECIPE_CACHE_TTL_DAYS=7
# How long an Epicure request may run before falling back to plain generation.
EPICURE_TIMEOUT_MS=12000

# ─── Cost controls ───────────────────────────────────────────────────────────
# Set AI_ENABLED=false to kill all AI immediately. Keep both AI switches false
# in production until the documented readiness prerequisites are complete.
# AI_DAILY_REQUEST_CAP is the global max actual provider attempts per UTC day.
AI_DAILY_REQUEST_CAP=200
AI_SUBJECT_DAILY_CALL_CAP=30
QUOTA_SCOPE_HMAC_KEY=
# PostgreSQL for shared atomic quotas and temporary generated state. Public
# endpoints require sslmode=verify-full. Railway private networking may use
# DATABASE_TRANSPORT=private-network without a public TLS URL.
DATABASE_URL=
# DATABASE_TRANSPORT=private-network
# MAX_SCAN_IMAGE_BYTES: max data-URL payload accepted by the API. The mobile
# client compresses camera photos below this limit before upload (default 2.5 MB).
MAX_SCAN_IMAGE_BYTES=2500000
# SCAN_RATE_LIMIT_WINDOW_MS: sliding window duration in ms for per-IP rate limit.
SCAN_RATE_LIMIT_WINDOW_MS=60000
# SCAN_RATE_LIMIT_MAX: max scan requests per IP per window.
SCAN_RATE_LIMIT_MAX=10

# ─── Runtime safety / overload protection ───────────────────────────────────
# Per-instance only. Set AI_MAX_CONCURRENCY below the provider's guaranteed
# limit, reserving headroom for retries and other environments.
AI_MAX_CONCURRENCY=12
AI_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
AI_CIRCUIT_BREAKER_RESET_MS=30000
API_MAX_IN_FLIGHT_REQUESTS=500
# Server deadline remains below the mobile's 60-second request deadline.
REQUEST_DEADLINE_MS=55000
SHUTDOWN_GRACE_PERIOD_MS=25000
# Set true only behind a known, trusted reverse proxy / load balancer.
TRUST_PROXY=false
# Exact comma-separated browser origins. Native Expo clients do not send an
# Origin header. In production, browser origins are denied unless listed.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Bounded local-only safety stores. Production request idempotency and AI
# generated state use PostgreSQL; non-AI/guest utilities may still use memory.
IDEMPOTENCY_TTL_MS=600000
IDEMPOTENCY_MAX_ENTRIES=2000
IN_MEMORY_ANALYSIS_MAX_ENTRIES=500
IN_MEMORY_GENERATED_RECIPE_MAX_ENTRIES=1000
IN_MEMORY_SCAN_CACHE_MAX_ENTRIES=200
# Protect /internal/metrics in production with a long random secret.
METRICS_TOKEN=

# ─── Account deletion (only required when Clerk sign-in is enabled) ──────────
# Backend-only secrets. The mobile client authenticates with a Clerk session
# token; never expose either of these in EXPO_PUBLIC_* variables.
CLERK_SECRET_KEY=
# REQUIRED in production: comma-separated exact `azp` values issued by Clerk
# for each shipped client. Use actual registered web origins (https://...) and
# native app URL schemes from Clerk. Do not use wildcards or guessed values.
# CLERK_AUTHORIZED_PARTIES=<exact-production-web-origin>,<exact-native-azp>
# Configure BOTH variables before enabling RevenueCat purchases. Leave both
# empty for a subscription-free launch; partial configuration fails closed.
# The v2 secret must have customer_information:customers:read_write permission.
REVENUECAT_PROJECT_ID=
REVENUECAT_V2_SECRET_API_KEY=
# Needed only for server-side Sign in with Apple token revocation during
# account deletion. These values belong in the API secret manager, never Expo.
APPLE_SIGN_IN_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=

# ─── Image generation (future feature, currently disabled) ───────────────────
# Set IMAGE_GEN_ENABLED=true when image generation is wired up.
IMAGE_GEN_ENABLED=false
IMAGE_GEN_DAILY_REQUEST_CAP=0

# ─── Analytics (PostHog, backend) ───────────────────────────────────────────
# Server-side event capture (ai_generation cost/latency/failure events).
# Disabled without a key. To enable, set ANALYTICS_ENABLED exactly to NODE_ENV
# (development or production); setting it to off or any mismatch disables it.
# POSTHOG_PROJECT_API_KEY is preferred; POSTHOG_API_KEY is accepted as fallback.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# ANALYTICS_ENABLED=

# Local JSONL quality logs are enabled in development and OFF by default in
# production. Do not set these to true unless their paths are durable shared
# storage with retention/rotation managed outside the API container.
# RECIPE_QUALITY_ANALYTICS=true
# EPICURE_ANALYTICS=true

# ─── Crash / error reporting (Sentry, backend) ──────────────────────────────
# Optional. Must match NODE_ENV exactly (development/production); no traces or
# request bodies are collected. Upload source maps only from controlled CI.
SENTRY_DSN=
SENTRY_ENABLED=
SENTRY_RELEASE=
# SENTRY_INTERNAL_PROBE=true (manual QA only; never ship this flag)

# Server-only Clerk user IDs allowed to see local development experiment tools.
# The client receives a single capability flag, never this private allowlist.
OKYO_EXPERIMENT_ADMIN_USER_IDS=
