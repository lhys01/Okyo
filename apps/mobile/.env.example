# Production and staging builds require an HTTPS endpoint. Leave this blank
# until one is deployed; development has a LAN fallback in src/api/config.ts.
EXPO_PUBLIC_OKYO_API_URL=
# EXPO_PUBLIC_OKYO_API_URL=http://192.168.2.42:8081

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
# Email/password and Google sign-in/sign-up are enabled in Clerk Production.
# Apple is wired in the app but still requires Apple Developer credentials in
# Clerk before Production Apple sign-in/sign-up will work. Phone, username,
# magic links, and passkeys remain disabled. The OAuth allowlist in
# src/auth/authStrategies.ts controls social buttons only; email/password has
# its own Clerk-backed form.
#
# The publishable key is safe to ship in the app bundle. NEVER put a Clerk
# SECRET key (sk_live_… / sk_test_…) in this app — it belongs only on a
# server. Keep real values in an ignored .env.local file.
# Get it from: Clerk Dashboard > Configure > API keys > Publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# RevenueCat public SDK configuration. Development uses only the Test Store
# key; release builds use only their matching platform key and never fall back
# to Test Store. Keep real values in an ignored .env.local file.
EXPO_PUBLIC_OKYO_SUBSCRIPTIONS_ENABLED=false
EXPO_PUBLIC_REVENUECAT_TEST_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Exact identifier from RevenueCat Dashboard > Product catalog > Entitlements.
# Products must also be attached to this entitlement in the dashboard.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=

# Exact comma-separated Clerk email allowlist for private onboarding experiment
# preview controls in Settings. Leave blank for builds distributed to users.
# This only controls client-side visibility; it is not a backend security rule.

# Dev-only private model override. Leave unset for normal OpenRouter scans.
# Only "fable" is honored, and only in __DEV__ builds.
# EXPO_PUBLIC_OKYO_DEV_AI_MODEL=fable

# ─── Analytics (PostHog) ─────────────────────────────────────────────────────
# Development uses only project 584818. Never reuse its token in Production.
# Production requires its own PostHog project ID, token, and matching opt-in.
# Events are explicit, allow-listed, anonymous, and sent to US Cloud only.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_PROJECT_ID=584818
EXPO_PUBLIC_ANALYTICS_ENABLED=

# ─── Crash / error reporting (Sentry) ───────────────────────────────────────
# Optional public DSN; integration sends sanitized exception type/stack/build
# metadata only, with native capture, breadcrumbs, traces and replay disabled.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ENABLED=
