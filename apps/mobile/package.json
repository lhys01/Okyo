    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.16.1",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/react-native-skia": "2.4.18",
    "expo": "~55.0.31",
    "expo-apple-authentication": "~55.0.17",
    "expo-auth-session": "^55.0.18",
    "expo-blur": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-clipboard": "~55.0.17",
    "expo-crypto": "^55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "~55.0.24",
    "expo-keep-awake": "~55.0.8",
    "expo-notifications": "~55.0.27",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-video": "~55.0.21",
    "expo-web-browser": "~55.0.20",
    "iconoir-react-native": "7.11.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-pager-view": "8.0.0",
    "react-native-purchases": "^10.6.0",
    "react-native-purchases-ui": "^10.6.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-view-shot": "4.0.3",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tsx": "^4.23.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start --port 8082",
    "postinstall": "node scripts/patch-expo-hmr.mjs",
    "sim": "expo start -c --host lan --port 8082",
    "android": "expo run:android",
    "ios": "expo run:ios --port 8082",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "validate-assets": "node scripts/validate-assets.mjs",
    "generate:legal-drafts": "node --import tsx scripts/generate-legal-drafts.ts",
    "preflight:release": "npm run icons:check && node --import tsx scripts/validate-release-config.ts --environment",
    "preflight:release:config": "npm run icons:check && node --import tsx scripts/validate-release-config.ts",
    "test": "node --import tsx --test",
    "icons:generate": "node scripts/sync-app-icons.mjs",
    "icons:check": "node scripts/validate-app-icon.mjs && node scripts/sync-app-icons.mjs --check",
    "preios": "npm run icons:check && node scripts/sync-app-icons.mjs --native ios && npm run splash:sync",
    "preandroid": "npm run icons:check && node scripts/sync-app-icons.mjs --native android",
    "splash:sync": "node scripts/sync-launch-screen.mjs",
    "build:ios:release": "bash scripts/build-ios-release.sh"
  },
  "private": true
}
