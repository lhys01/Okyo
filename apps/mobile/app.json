{
  "expo": {
    "name": "Okyo",
    "slug": "okyo",
    "scheme": "okyo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/onboarding/onboarding-ex/onboarding1.png",
      "resizeMode": "contain",
      "backgroundColor": "#fffdfe"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.okyo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111013",
        "foregroundImage": "./assets/app-icon/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.okyo"
    },
    "web": {
      "favicon": "./assets/app-icon/favicon.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-notifications",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fffdfe",
          "image": "./assets/onboarding/onboarding-ex/onboarding1.png",
          "imageWidth": 430,
          "resizeMode": "cover"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Okyo to access your photos so you can scan a dish."
        }
      ],
      "expo-video"
    ]
  }
}
