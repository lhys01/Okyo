---
import { APP_STATUS_LABEL } from '../config/site';
interface Props { small?: boolean; }
const { small = false } = Astro.props;
---
<span class="coming-soon">
  <span class:list={['status-badge', { 'status-badge--small': small }]}>{APP_STATUS_LABEL}</span>
  <button class="waitlist-link" type="button" data-open-waitlist>Join the waitlist <span aria-hidden="true">↗</span></button>
</span>
<style>
  .coming-soon { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 4px; max-width: 100%; }
  .waitlist-link { min-height: 44px; padding: 4px 2px; color: var(--ink); font: inherit; font-size: var(--text-small); font-weight: 800; background: none; border: 0; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .waitlist-link:hover { color: #a6375a; }
</style>
