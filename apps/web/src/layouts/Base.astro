---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaitlistDialog from '../components/WaitlistDialog.astro';
import { SITE_NAME, SITE_URL } from '../config/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Set false for pages with no real URL (the 404 page). */
  canonical?: boolean;
}

const { title, description, noindex = false, canonical: hasCanonical = true } = Astro.props;
// Legal and support pages stay usable independently of the launch campaign.
const showLaunchCampaign = Astro.url.pathname === '/';
const pageTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
// Clean URL with no trailing slash or ".html" (build.format is 'file').
const cleanPath = Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '').replace(/\/$/, '');
const canonical = `${SITE_URL}${cleanPath}`;

const appIcon = '/okyo-icon.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {hasCanonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#fffdfe" />
    <link rel="icon" type="image/png" href={appIcon} />
    <link rel="apple-touch-icon" href={appIcon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {hasCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(appIcon, SITE_URL).href} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header showLaunchCampaign={showLaunchCampaign} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {showLaunchCampaign && <WaitlistDialog />}
  </body>
</html>
