---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import foxRecipeCard from '../assets/brand/fox-recipe-card.png';
import '../styles/prose.css';
---

<Base title="Page not found" description="This Okyo page could not be found." noindex canonical={false}>
  <div class="container page">
    <div class="not-found content-panel">
      <Image src={foxRecipeCard} alt="" widths={[220, 440, 660]} sizes="220px" class="not-found__fox" />
      <div class="prose">
        <h1>This page isn't on the menu.</h1>
        <p>The link may be old or mistyped.</p>
        <p><a href="/">Go to the Okyo home page</a> or <a href="/support">get support</a>.</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .not-found {
    display: grid;
    gap: var(--space-lg);
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .not-found__fox {
    width: 220px;
  }

  .not-found .prose > :last-child {
    margin-bottom: 0;
  }
</style>
